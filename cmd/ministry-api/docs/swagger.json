{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Ministry REST API — proxy layer over VIP server (vip.vpn.works).",
        "title": "Ministry API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/reserve": {
            "post": {
                "description": "Marks a brigade as paid on the VIP server. The brigade must already\nexist in the ministry DB (created via SSH reqvipid).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vip"
                ],
                "summary": "Reserve VIP brigade",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bearer \u003cbase64url-partner-token\u003e",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "brigade_id (obfuscated) + expire_at",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.ReserveRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.ReserveResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "main.ReserveRequest": {
            "type": "object",
            "properties": {
                "brigade_id": {
                    "type": "string"
                },
                "user_identity": {
                    "type": "string"
                }
            }
        },
        "main.ReserveResponse": {
            "type": "object",
            "properties": {
                "ok": {
                    "type": "boolean"
                }
            }
        }
    }
}